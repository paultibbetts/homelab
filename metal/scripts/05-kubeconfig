#!/usr/bin/env bash
# https://docs.siderolabs.com/talos/v1.12/getting-started/prodnotes#step-15-get-kubernetes-access

set -e

source "$(dirname "$0")/lib/env"

: "${CLUSTER_NAME:?CLUSTER_NAME is required}"
: "${CONTROL_PLANE_IP:?CONTROL_PLANE_IP is required}"

KUBE_CONTEXT="admin@${CLUSTER_NAME}"
kubeconfig_args=(--nodes "${CONTROL_PLANE_IP[0]}")

if kubectl config get-contexts "$KUBE_CONTEXT" >/dev/null 2>&1; then
  if [[ "${FORCE:-0}" != "1" ]]; then
    echo "Kubernetes context '$KUBE_CONTEXT' already exists in your kubeconfig"
    echo "Refusing to replace it without confirmation."
    echo "Run FORCE=1 ./scripts/05-kubeconfig to replace that context for a rebuilt cluster."
    exit 1
  fi

  kubeconfig_args+=(--force)
fi

talosctl kubeconfig "${kubeconfig_args[@]}"
