import PocketBase from "pocketbase";

const knownNames = {
  deskpi: "DeskPi",
  gitea: "Gitea",
  jellyfin: "Jellyfin",
  mysql: "MySQL",
  pihole: "Pi-hole",
  postgres: "Postgres",
  vpn: "VPN",
  ingress: "Ingress",
  github: "GitHub",
};

function toSmartTitle(str) {
	return str
		.replace(/[-_]/g, ' ')
		.replace(/\b\w/g, c => c.toUpperCase());
}

function formatSystemName(raw) {
	const key = raw.toLowerCase();
	return knownNames[key] || toSmartTitle(raw);
}

const pb = new PocketBase("https://beszel.cloud.paultibbetts.uk");

await pb.admins.authWithPassword(
  "{{ vault_beszel_agent_username }}",
  "{{ vault_beszel_agent_password }}"
);
const data = {
	"name": formatSystemName("{{ ansible_hostname }}"),
	"status": "up",
	"host": "{{ hostvars[inventory_hostname]['ansible_host'] | default(inventory_hostname) }}",
	"port": "{{ beszel_agent_ssh_port }}",
	"info": "JSON",
	"users": [
		"4d3h2zmwnnfl5g9",
	],
};

async function createSystemIfNotExists(name, data) {
	try {
		// Check if record exists by name
		const existing = await pb.collection("systems")
			.getFirstListItem(`name="${name}"`);
		console.log(
			`System "${name}" already exists with ID:`,
			existing.id,
		);
		return existing;
	} catch (err) {
		if (err.status === 404) {
			// Not found, so create it
			const created = await pb.collection("systems").create(
				data,
			);
			console.log(
				`Created new system "${name}" with ID:`,
				created.id,
			);
			return created;
		} else {
			console.error("Error:", e);
			console.error("Status:", e.status);
			console.error("Response:", e.response);
			throw err; // Some other error
		}
	}
}

createSystemIfNotExists(data.name, data);

try {
	const record = await pb.collection("systems").create(data);
	console.log("Created:", record);
} catch (e) {
	console.error("Error:", e);
	console.error("Status:", e.status);
	console.error("Response:", e.response);
}
