name: pangolin
services:
  pangolin:
    image: "docker.io/fosrl/pangolin:{{ pangolin_image_tag }}"
    container_name: pangolin
    restart: unless-stopped
    volumes:
      - "{{ pangolin_project_dir }}/config:/app/config"
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001/api/v1/"]
      interval: "10s"
      timeout: "10s"
      retries: 15
{% if pangolin_install_gerbil | bool %}
  gerbil:
    image: "docker.io/fosrl/gerbil:{{ gerbil_image_tag }}"
    container_name: gerbil
    restart: unless-stopped
    depends_on:
      pangolin:
        condition: service_healthy
    command:
      - --reachableAt=http://gerbil:3004
      - --generateAndSaveKeyTo=/var/config/key
      - --remoteConfig=http://pangolin:3001/api/v1/
    volumes:
      - "{{ pangolin_project_dir }}/config:/var/config"
    cap_add:
      - NET_ADMIN
      - SYS_MODULE
    ports:
      - 51820:51820/udp
      - 21820:21820/udp
      - 443:443
      - 80:80
{% endif %}
{% if pangolin_enable_crowdsec | bool %}
  crowdsec:
    command: -t
    container_name: crowdsec
    environment:
      COLLECTIONS: crowdsecurity/traefik crowdsecurity/appsec-virtual-patching crowdsecurity/appsec-generic-rules
      ENROLL_INSTANCE_NAME: pangolin-crowdsec
      ENROLL_TAGS: docker
      GID: "1000"
      PARSERS: crowdsecurity/whitelists
    healthcheck:
      interval: 10s
      retries: 3
      start_period: 30s
      test:
        - CMD
        - cscli
        - lapi
        - status
      timeout: 5s
    image: "docker.io/crowdsecurity/crowdsec:{{ crowdsec_image_tag }}"
    labels:
      - traefik.enable=false
    ports:
      - 6060:6060
    restart: unless-stopped
    volumes:
      - "{{ pangolin_project_dir }}/config/crowdsec:/etc/crowdsec"
      - "{{ pangolin_project_dir }}/config/crowdsec/db:/var/lib/crowdsec/data"
      - "{{ pangolin_project_dir }}/config/traefik/logs:/var/log/traefik"
{% endif %}
{% if pangolin_enable_geoblocking | bool %}
  geoipupdate:
    container_name: geoipupdate
    env_file:
      - "{{ pangolin_env_file_path }}"
    image: "ghcr.io/maxmind/geoipupdate:{{ geoipupdate_image_tag }}"
    restart: unless-stopped
    volumes:
      - "{{ pangolin_project_dir }}/config/GeoLite2:/usr/share/GeoIP"
{% endif %}
  traefik:
    image: "docker.io/traefik:{{ traefik_image_tag }}"
    container_name: traefik
    restart: unless-stopped
{% if pangolin_install_gerbil | bool %}
    network_mode: service:gerbil
{% else %}
    ports:
      - 443:443
      - 80:80
{% endif %}
    depends_on:
{% if pangolin_enable_crowdsec | bool %}
      crowdsec:
        condition: service_healthy
{% endif %}
      pangolin:
        condition: service_healthy
    command:
      - --configFile=/etc/traefik/traefik_config.yml
    volumes:
      - "{{ pangolin_project_dir }}/config/traefik:/etc/traefik:ro"
      - "{{ pangolin_project_dir }}/config/letsencrypt:/letsencrypt"
      - "{{ pangolin_project_dir }}/config/traefik/logs:/var/log/traefik"

networks:
  default:
    driver: bridge
    name: pangolin
{% if pangolin_enable_ipv6 | bool %}
    enable_ipv6: true
{% endif %}
