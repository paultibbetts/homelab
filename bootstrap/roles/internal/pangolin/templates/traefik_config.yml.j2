# Managed by Ansible. Manual edits will be overwritten.
{% if pangolin_enable_crowdsec | bool %}
accessLog:
  bufferingSize: 100
  fields:
    defaultMode: drop
    headers:
      defaultMode: drop
      names:
        Authorization: redact
        Content-Type: keep
        Cookie: redact
        User-Agent: keep
        X-Forwarded-For: keep
        X-Forwarded-Proto: keep
        X-Real-Ip: keep
    names:
      ClientAddr: keep
      ClientHost: keep
      DownstreamContentSize: keep
      DownstreamStatus: keep
      Duration: keep
      RequestMethod: keep
      RequestPath: keep
      RequestProtocol: keep
      RetryAttempts: keep
      ServiceName: keep
      StartUTC: keep
      TLSCipher: keep
      TLSVersion: keep
  filePath: "/var/log/traefik/access.log"
  filters:
    minDuration: 100ms
    retryAttempts: true
    statusCodes:
      - 200-299
      - 400-499
      - 500-599
  format: json
{% endif %}

api:
  dashboard: true
  insecure: true

certificatesResolvers:
  letsencrypt:
    acme:
      caServer: "https://acme-v02.api.letsencrypt.org/directory"
      email: "{{ pangolin_letsencrypt_email }}"
      httpChallenge:
        entryPoint: web
      storage: "/letsencrypt/acme.json"

entryPoints:
  web:
    address: ":80"
{% if pangolin_trusted_proxy_cidrs | length > 0 %}
    proxyProtocol:
      trustedIPs:
{% for cidr in pangolin_trusted_proxy_cidrs %}
        - "{{ cidr }}"
{% endfor %}
{% endif %}
  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt
{% if not pangolin_enable_crowdsec | bool %}
      encodedCharacters:
        allowEncodedSlash: true
        allowEncodedQuestionMark: true
{% endif %}
{% if pangolin_enable_crowdsec | bool %}
      middlewares:
        - crowdsec@file
{% endif %}
    transport:
      respondingTimeouts:
        readTimeout: "30m"
{% if pangolin_trusted_proxy_cidrs | length > 0 %}
    proxyProtocol:
      trustedIPs:
{% for cidr in pangolin_trusted_proxy_cidrs %}
        - "{{ cidr }}"
{% endfor %}
{% endif %}

experimental:
  plugins:
    badger:
      moduleName: "github.com/fosrl/badger"
      version: "v1.3.1"
{% if pangolin_enable_crowdsec | bool %}
    crowdsec:
      moduleName: "github.com/maxlerebourg/crowdsec-bouncer-traefik-plugin"
      version: "v1.4.4"
{% endif %}

log:
  compress: true
  format: "{% if pangolin_enable_crowdsec | bool %}json{% else %}common{% endif %}"
  level: "INFO"
  maxAge: 3
  maxBackups: 3
  maxSize: 100

ping:
  entryPoint: "web"

providers:
  file:
    filename: "/etc/traefik/dynamic_config.yml"
  http:
    endpoint: "http://pangolin:3001/api/v1/traefik-config"
    pollInterval: "5s"

serversTransport:
  insecureSkipVerify: true
