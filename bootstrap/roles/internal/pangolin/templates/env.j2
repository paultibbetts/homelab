GEOIPUPDATE_LICENSE_KEY={{ pangolin_maxmind_license_key }}
{% endif %}
{% for item in pangolin_env_extra | default({}) | dictsort %}
{{ item.0 }}={{ item.1 }}
{% endfor %}
